## 5. Signal Store del Dashboard

```typescript
// features/dashboard/store/dashboard.store.ts

import { computed, signal } from '@angular/core';
import { SesionOperativa, AlertaEmergencia, EstadoOperativo } from '@core/models';

export class DashboardStore {

  // ─── State signals ───────────────────────────────────────────────────────
  readonly unidadesActivas    = signal<SesionOperativa[]>([]);
  readonly alertasSOS         = signal<AlertaEmergencia[]>([]);
  readonly unidadSeleccionada = signal<SesionOperativa | null>(null);

  // Capas del mapa
  readonly layerHeatmap    = signal<boolean>(true);
  readonly layerSIMcards   = signal<boolean>(true);
  readonly layerPoligonos  = signal<boolean>(true);

  // ─── Computed (derivaciones reactivas) ──────────────────────────────────
  readonly conteoDisponibles  = computed(() =>
    this.unidadesActivas().filter(u => u.estado_operativo === EstadoOperativo.DISPONIBLE).length
  );
  readonly conteoEnRuta       = computed(() =>
    this.unidadesActivas().filter(u => u.estado_operativo === EstadoOperativo.EN_RUTA_HOTSPOT).length
  );
  readonly conteoPatrullando  = computed(() =>
    this.unidadesActivas().filter(u => u.estado_operativo === EstadoOperativo.PATRULLANDO_ZONA).length
  );
  readonly conteoEmergencia   = computed(() =>
    this.unidadesActivas().filter(u => u.estado_operativo === EstadoOperativo.OCUPADO_EMERGENCIA).length
  );
  readonly tieneEmergenciaActiva = computed(() =>
    this.alertasSOS().some(a => a.estado === 'ACTIVA')
  );
}
```

