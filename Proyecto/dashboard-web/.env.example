# ============================================================
# S.I.G.O. — Variables de Entorno (Desarrollo Local)
# ============================================================
# INSTRUCCIONES:
#   1. Copia este archivo y renómbralo como .env
#   2. Rellena los valores con tus credenciales reales
#   3. NUNCA subas el archivo .env al repositorio Git
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# Encuéntralos en: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Google Maps ─────────────────────────────────────────────
# Crea la key en: https://console.cloud.google.com → APIs → Credentials
# Habilitar: Maps JavaScript API + Maps Visualization API
GOOGLE_MAPS_API_KEY=AIzaSy...

# ── Backend Node.js ─────────────────────────────────────────
API_BASE_URL=http://localhost:3000/api

# ── Broker MQTT (WebSockets) ─────────────────────────────────
MQTT_BROKER_URL=wss://localhost:8084/mqtt

# ── Configuración del mapa (Centro Santiago por defecto) ────
MAP_DEFAULT_LAT=-33.4569
MAP_DEFAULT_LNG=-70.6483
MAP_DEFAULT_ZOOM=12
