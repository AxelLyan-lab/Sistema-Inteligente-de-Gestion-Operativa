{
  "expo": {
    "name": "S.I.G.O. Patrol",
    "slug": "sigo-patrol-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A2E"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cl.sigo.patrolapp",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "S.I.G.O. Patrol necesita acceso a tu ubicación para el patrullaje.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "S.I.G.O. Patrol necesita acceso continuo a tu ubicación durante el turno.",
        "NSCameraUsageDescription": "S.I.G.O. Patrol necesita la cámara para capturar evidencias tácticas.",
        "NSPhotoLibraryUsageDescription": "S.I.G.O. Patrol necesita acceso a fotos para adjuntar evidencias."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1A2E"
      },
      "package": "cl.sigo.patrolapp",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA_-TfqBzBEuE2xD7haWm0fEcfVRF1hs3w"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-location",
      [
        "expo-camera",
        {
          "cameraPermission": "S.I.G.O. Patrol necesita la cámara para capturar evidencias."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "S.I.G.O. Patrol accede a tus fotos para adjuntar evidencias.",
          "cameraPermission": "S.I.G.O. Patrol necesita la cámara para capturar evidencias."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:3000/api/v1",
